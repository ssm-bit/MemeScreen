# MemeScreen execution service — copy to .env for local work. On Railway/Render put these in the service's Variables.
# REQUIRED
MASTER_KEY=                 # 64 hex chars: openssl rand -hex 32   (encrypts every user's wallet key; losing it loses the wallets)
BACK4APP_APP_ID=CRzmZVtYdNTKZ8UJiFiAdzayCn68qcxqomDh3TBw
BACK4APP_JS_KEY=d5ZabG61ROOuG6wxyhZT0krGp3faDiNOyTdovytV
# RECOMMENDED
BACK4APP_MASTER_KEY=        # lets the service push notifications to users (pushToUser). Back4App → App Settings → Security & Keys
DATABASE_URL=               # Postgres URL from the Railway/Render add-on. Empty = SQLite file (local only)
RPC_URL=                    # Helius or other paid RPC, e.g. https://mainnet.helius-rpc.com/?api-key=KEY . Empty = public RPCs
ALLOWED_ORIGINS=https://ssm-bit.github.io,http://localhost:5173,http://127.0.0.1:5173
# OPTIONAL
PORT=4100
WATCH_MS=3000               # how often the watcher checks exits
WATCHER=on                  # off = API only
JUPITER_KEY=                # portal.jup.ag key raises the quote rate limit
PLATFORM_FEE_BPS=0          # integrator fee on swaps (needs FEE_ACCOUNT, a wrapped-SOL token account we own)
FEE_ACCOUNT=
SQLITE_FILE=./exec.sqlite
