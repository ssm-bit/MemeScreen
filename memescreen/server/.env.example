# Copy this file to ".env" and fill in your values.

# --- Database ---
# LOCAL Postgres example:
# DATABASE_URL=postgres://postgres:YOURPASSWORD@localhost:5432/memescreen
# CLOUD (Supabase / Neon / Railway) — paste the connection string they give you:
DATABASE_URL=postgres://postgres:YOURPASSWORD@localhost:5432/memescreen

# --- Auth ---
# Any long random string. Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

# --- Server ---
PORT=4000
